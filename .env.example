ALGOFORGE_ENV=local
ALGOFORGE_DATA_DIR=./data
ALGOFORGE_RUNS_DIR=./runs
ALGOFORGE_API_URL=http://127.0.0.1:8765
# Optional research providers; test or read-only credentials only.
DATABENTO_API_KEY=
FRED_API_KEY=
MODEL_PROVIDER=
MODEL_API_KEY=
# OpenCode Go ($10/month subscription). Note the base URL is /zen/go/v1, not
# /zen/v1 — a Go key on the Zen endpoint fails with a misleading balance error.
# The second key is an optional standby for a rotated or revoked primary.
OPENCODE_API_KEY=
OPENCODE_API_KEY_2=
# DeepSeek called directly, pay-as-you-go against its own balance. Independent
# of the OpenCode allowance, so it still answers when that window is spent.
# Note the ids differ from the gateway's: deepseek-flash here, not
# deepseek-v4-flash.
DEEPSEEK_API_KEY=
NVIDIA_NIM_API_KEY=
