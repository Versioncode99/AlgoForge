.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.py[cod]
*.db
/data/
/runs/
/artifacts/
/config/settings.json
# Where this machine keeps its workspace. It names a local path, so it is
# operator state rather than a project decision.
/config/storage.json
# Strategy folders are generated working state: the engine writes dozens per
# session from the templates in packages/forge/strategy/templates.py, which are
# what is actually version-controlled. Keeping every autonomous variant would
# bury the repo within a day. They live on disk and are visible in the app.
/strategies/*/
node_modules/
dist/
playwright-report/
test-results/
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Playwright artifacts from a local run.
apps/web/test-results/
apps/web/playwright-report/

# The research vault's own notes are repository content; the papers a search
# retrieves at runtime are not. A test run writes them, and they arrived in a
# commit once before this rule existed.
research/notes/Research Papers/

# The vault's dashboard note. `create_app` rewrites it on every start with a
# wall-clock timestamp and the current note counts, so in a checkout the
# resolver has adopted as its workspace it is dirty again the moment anything
# runs. It is a per-installation view of machine state, unlike the family notes
# beside it, which are deterministic repository content.
research/notes/AlgoForge.md

# Rithmic's SDK is licensed to the operator and is not redistributable: its own
# release notes state that reproducing or distributing any portion of it may be
# prosecuted. An operator may unpack it here for convenience; git must refuse it.
# Generated protobuf modules are derivatives of the .proto files, so they go too.
vendor/rithmic/
*_pb2.py
*_pb2.pyi
